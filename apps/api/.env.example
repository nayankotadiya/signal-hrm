# Signal HRM API configuration. Copy to .env.development / .env.staging / .env.production.
# Never commit real values. Secrets live only on the server.

# development | staging | production
APP_ENV=development
PORT=3000
API_PREFIX=api
# Comma-separated list of allowed web origins (the Flutter PWA)
CORS_ORIGINS=http://localhost:8080,http://localhost:5000

# MongoDB Atlas. Use a separate database per environment.
# Required when APP_ENV=staging or production. Leave empty in development to boot without a database
# (health will report the database as "unknown", never "healthy").
MONGODB_URI=
MONGODB_DB_NAME=signal_hrm_dev
# Storage capacity limit in Megabytes (default 512 for MongoDB Atlas M0 free tier, or cluster size)
# When database capacity reaches >= 90%, critical alerts are dispatched to Admins and Super Admins.
MONGODB_STORAGE_LIMIT_MB=512

# Redis (cache and queues). Required in staging and production.
REDIS_URL=

# Rate limiting (per client IP)
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# File storage provider: none | local | google_drive (see Files below)
STORAGE_PROVIDER=local

# Paid or optional features stay off by default to keep operating cost minimal
FEATURE_AI_ASSISTANT=false

# Health thresholds (milliseconds) above which a component is reported "degraded"
HEALTH_DB_DEGRADED_MS=500
HEALTH_REDIS_DEGRADED_MS=200
HEALTH_CHECK_TIMEOUT_MS=2000

LOG_LEVEL=log
# Reverse-proxy hops to trust for client IPs (set 1 behind Caddy in production)
TRUST_PROXY=0

# ---- Auth (required outside development; 32+ random characters each) ----
PUBLIC_WEB_URL=http://localhost:8080
JWT_SECRET=
OTP_PEPPER=
ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Development only: print OTP codes in the API console when no SMTP is configured
OTP_DEV_ECHO=true
# Comma-separated OAuth client IDs whose ID tokens are accepted
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# true in production (HTTPS)
COOKIE_SECURE=false

# ---- Email ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Signal HRM <no-reply@localhost>

# ---- SMS OTP Gateway (Twilio / Fast2SMS / Custom HTTP) ----
# Real SMS delivery for mobile phone OTP login and verification.
# If unset or development mode with OTP_DEV_ECHO=true, codes are logged to console.
# 1. Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
# 2. Fast2SMS (popular for India SMS OTP delivery)
FAST2SMS_API_KEY=
# 3. Custom HTTP SMS Gateway
SMS_GATEWAY_URL=
SMS_API_KEY=

# ---- Files & Google Drive Cloud Storage ----
# Options: none | local | google_drive
# For high-volume facial photos, employee documents, and system backups, set STORAGE_PROVIDER=google_drive
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./var/storage
# When using STORAGE_PROVIDER=google_drive:
# Paste the Google Service Account JSON string with Google Drive API enabled:
# GOOGLE_DRIVE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# Target folder ID in Google Drive (optional, defaults to root):
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
MAX_UPLOAD_MB=15
# NOTE: Attendance facial selfie photos are automatically retained for strictly 1 month 15 days (45 days)
# and automatically purged from Google Drive storage and the database nightly.

# ---- Automated Database Backups in Google Drive ----
# Automated backups take full compressed mongodump archives and stream/store directly to Google Drive
# Requires mongodump and mongorestore on the host (preinstalled or via apt-get install -y mongodb-database-tools)
BACKUP_ENABLED=true
BACKUP_CRON=30 2 * * *
BACKUP_WORK_DIR=./var/backups
# MONGODUMP_PATH=mongodump
# MONGORESTORE_PATH=mongorestore

# ---- Integrations ----
META_APP_SECRET=
META_VERIFY_TOKEN=
