{
  "name": "@signal-hrm/api",
  "version": "0.1.0",
  "description": "Signal HRM REST API (NestJS). People • Work • Time • Operations",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json --forceExit",
    "test:smoke": "node test/smoke/smoke.mjs",
    "test:all": "npm run typecheck && npm test && npm run test:e2e",
    "bootstrap": "node dist/scripts/bootstrap-super-admin.js",
    "seed:demo": "node dist/scripts/seed-demo.js",
    "provision": "node dist/scripts/provision.js"
  },
  "dependencies": {
    "@googleapis/drive": "^8.16.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.2.7",
    "cron": "^4.4.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "jose": "^5.10.0",
    "mongoose": "^8.15.0",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.15.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.3",
    "bson": "^6.10.4",
    "jest": "^29.7.0",
    "mingo": "^7.2.4",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.0",
    "typescript": "~5.8.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
